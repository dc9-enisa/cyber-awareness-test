# Publiczny adres aplikacji (https). Ten sam adres + /auth/callback i + /wylogowano wpisz w rejestracji aplikacji w Entra.
BASE_URL=https://szkolenie.twoja-organizacja.pl

# Microsoft Entra ID – rejestracja aplikacji (WDROZENIE.md, krok 1)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=

# Klucz podpisu sesji, co najmniej 32 bajty:  openssl rand -base64 32
SESSION_KEY=

# Nazwa organizacji na zaświadczeniu i w informacji o danych
ORG_NAME=Twoja Organizacja

# Administrator danych i kontakt (akapit w „Informacji o przetwarzaniu danych”)
PRIVACY_TEXT=Administratorem danych jest … Kontakt w sprawie danych: …

# Wartość roli aplikacji dającej dostęp do raportu (App roles w Entra)
ADMIN_ROLE=Raporty
# Opcjonalnie: loginy administratorów raportu bez roli, oddzielone przecinkami
ADMIN_UPNS=

# Dni przechowywania wyników (0 = bez automatycznego usuwania)
RETENTION_DAYS=365

# 1 = zaświadczenie tylko po zaliczeniu testu końcowego (próg z banku pytań), 0 = po każdym oddanym teście końcowym
CERT_REQUIRE_PASS=1
